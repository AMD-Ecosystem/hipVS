#include <cuvs/detail/jit_lto/FragmentEntry.hpp>

@fragment_tag_header_files@

// One embedded bitcode blob per GPU architecture family (see ArchFamily). Each
// header defines a uniquely named array; families not built produce nullptr / 0
// slots in the tables below (initializers are emitted in ArchFamily enum order).
@fatbin_family_includes@

namespace {

using fragment_tag   = @fragment_tag@;
using fragment_entry = StaticFatbinFragmentEntry<fragment_tag>;

}  // namespace

template <>
const uint8_t* const fragment_entry::data[kNumArchFamilies] = {
@fatbin_data_initializer@
};

template <>
const size_t fragment_entry::length[kNumArchFamilies] = {
@fatbin_length_initializer@
};
