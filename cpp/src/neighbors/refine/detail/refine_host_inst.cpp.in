#include <cuvs/core/export.hpp>
#include <cuvs/neighbors/refine.hpp>

#include <neighbors/refine/refine_host.hpp>

namespace {

using data_t         = @data_type@;
using index_t        = @index_type@;
using distance_t     = @distance_type@;
using matrix_index_t = @matrix_index_type@;

}  // namespace

namespace CUVS_EXPORT cuvs {
namespace neighbors {

void refine(
  raft::resources const& handle,
  raft::host_matrix_view<const data_t, matrix_index_t, raft::row_major> dataset,
  raft::host_matrix_view<const data_t, matrix_index_t, raft::row_major> queries,
  raft::host_matrix_view<const index_t, matrix_index_t, raft::row_major> neighbor_candidates,
  raft::host_matrix_view<index_t, matrix_index_t, raft::row_major> indices,
  raft::host_matrix_view<distance_t, matrix_index_t, raft::row_major> distances,
  cuvs::distance::DistanceType metric)
{
  refine_impl<index_t, data_t, distance_t, matrix_index_t>(
    handle, dataset, queries, neighbor_candidates, indices, distances, metric);
}

}  // namespace neighbors
}  // namespace CUVS_EXPORT cuvs
